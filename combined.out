fn int_double(val: int): int {
    return val * 2
}

main() {
    # 1. Safe Cast
    x = 42
    y = x as float
    @println("42 as float: %f\n", y)

    # safe cast truncation should warn during compile
    big = 100000000000
    small = big |> i32

    # 2. Forced Cast
    # force bitcast float to int (reinterpreting bits)
    f = 3.14159
    bits = f as! i64
    @println("3.14159 bitcasted to i64: %ld\n", bits)

    # 3. Built-in toString
    s = x.toString()
    @println("x.toString() = '%s'\n", s)

    # 4. Custom Property/Method injection
    # We defined int_double above! So we can call .double() on any int!
    d = 10.double()
    @println("10.double() = %d\n", d)

    0
}


# ── Basic class declaration, init, methods, property access ──

class Person {
    pub name: string
    pub age: int

    fn init(self: Person, name: string, age: int) {
        self.name = name
        self.age = age
    }

    pub fn greet(self: Person) {
        @println("Hi, I'm %s and I'm %d years old\n", self.name, self.age)
    }

    pub fn birthday(self: Person) {
        self.age = self.age + 1
    }
}

main() {
    p = Person("Dagim", 25)
    p.greet()
    p.birthday()
    p.greet()
    @println("Name: %s\n", p.name)
    @println("Age: %d\n", p.age)
    0
}


# ── Single inheritance with field + method inheritance ──

class Vehicle {
    pub brand: string
    pub speed: int

    fn init(self: Vehicle, brand: string, speed: int) {
        self.brand = brand
        self.speed = speed
    }

    pub fn honk(self: Vehicle) {
        @println("%s goes BEEP!\n", self.brand)
    }
}

class Car : Vehicle {
    pub doors: int

    fn init(self: Car, brand: string, speed: int, doors: int) {
        self.brand = brand
        self.speed = speed
        self.doors = doors
    }

    pub fn info(self: Car) {
        @println("%s: %d doors, %d km/h\n", self.brand, self.doors, self.speed)
    }
}

class ElectricCar : Car {
    pub battery: int

    fn init(self: ElectricCar, brand: string, speed: int, doors: int, battery: int) {
        self.brand = brand
        self.speed = speed
        self.doors = doors
        self.battery = battery
    }

    pub fn charge(self: ElectricCar) {
        @println("Charging %s (%d%% battery)\n", self.brand, self.battery)
    }
}

main() {
    v = Vehicle("Horn Co", 60)
    v.honk()

    c = Car("Toyota", 180, 4)
    c.info()
    c.honk()

    e = ElectricCar("Tesla", 250, 4, 85)
    e.charge()
    e.info()
    e.honk()
    @println("Battery: %d%%\n", e.battery)
    0
}


# ── Interface declaration ──

interface Drawable {
    fn draw(self: Drawable)
}

interface Resizable {
    fn resize(self: Resizable, factor: int)
}

class Circle {
    pub radius: int

    fn init(self: Circle, r: int) {
        self.radius = r
    }

    pub fn draw(self: Circle) {
        @println("Drawing circle with radius %d\n", self.radius)
    }

    pub fn resize(self: Circle, factor: int) {
        self.radius = self.radius * factor
    }
}

main() {
    c = Circle(5)
    c.draw()
    c.resize(3)
    c.draw()
    @println("Final radius: %d\n", c.radius)
    0
}
# Test: Advanced collections - comprehensions, slices, and tuples

main() {
    # 1. Array Comprehensions
    nums = [1, 2, 3, 4, 5]
    squares = [x * x for x in nums]
    @print("Squares: ")
    for s in squares { @print("%d ", s) }
    @println("")

    # Range comprehension
    even_squares = [x * x for x in 0..10] # 0, 1, 4, 9, 16, 25, 36, 49, 64, 81
    @print("Range squares: ")
    for s in even_squares { @print("%d ", s) }
    @println("")

    # 2. Slicing
    sub = squares[1..4] # [4, 9, 16]
    @print("Slice [1..4]: ")
    for x in sub { @print("%d ", x) }
    @println("")

    # Inclusive slice
    sub_inc = squares[1...3] # [4, 9, 16]
    @print("Slice [1...3]: ")
    for x in sub_inc { @print("%d ", x) }
    @println("")

    # 3. Tuples and Destructuring
    t = (10, "hello", 3.14)
    mut a = 0
    mut b = ""
    mut c = 0.0
    (a, b, c) = t
    @println("Tuple unpack: a=%d, b=%s, c=%f", a, b, c)

    # Array of tuples
    points = [(1, 2), (3, 4), (5, 6)]
    @print("Points: ")
    for p in points {
        mut px = 0
        mut py = 0
        (px, py) = p
        @print("(%d, %d) ", px, py)
    }
    @println("")

    # 4. Array repeat
    zeros = [0; 5]
    @print("Zeros: ")
    for z in zeros { @print("%d ", z) }
    @println("")

    0
}


