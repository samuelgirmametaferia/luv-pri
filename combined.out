# Test: String interpolation and methods

main() {
    name = "World"
    age = 42
    pi = 3.14159
    
    # Interpolation
    # The grammar says &"..." or &`...` for interpolation
    msg = &"Hello, {name}! You are {age} years old. PI is {pi}."
    @println("%s", msg)

    # String methods
    s = "  Luv Language  "
    trimmed = s.trim()
    @println("Original: '%s'", s)
    @println("Trimmed:  '%s'", trimmed)
    @println("Length:   %d", s.length())
    
    upper = trimmed.toUpper()
    lower = trimmed.toLower()
    @println("Upper: %s", upper)
    @println("Lower: %s", lower)

    if trimmed.startsWith("Luv") {
        @println("Starts with Luv")
    }
    
    if trimmed.contains("Language") {
        @println("Contains Language")
    }

    idx = trimmed.indexOf("Lang")
    @println("Index of 'Lang': %d", idx)

    0
}


# ── Structs still work alongside classes ──

struct Point {
    x: int
    y: int
}

fn Point add(a: Point, b: Point): Point {
    Point { x: a.x + b.x, y: a.y + b.y }
}

class Canvas {
    pub width: int
    pub height: int

    fn init(self: Canvas, w: int, h: int) {
        self.width = w
        self.height = h
    }

    pub fn describe(self: Canvas) {
        @println("Canvas %dx%d\n", self.width, self.height)
    }
}

main() {
    a = Point { x: 10, y: 20 }
    b = Point { x: 5, y: 15 }
    c = a.add(b)
    @println("Point: %d, %d\n", c.x, c.y)

    canvas = Canvas(800, 600)
    canvas.describe()
    0
}


