class Vector {
    pub x: int
    pub y: int

    pub fn set(newX: int, newY: int) {
        self.x = newX
        self.y = newY
    }
}

main() {
    v = Vector()
    v->x = 10
    v->y = 20
    
    # Compound assignment
    v->x += 5
    v->y *= 2
    
    # Postfix
    v->x++
    v->y--
    
    # Now check values
    if (v.x == 16 && v.y == 39) {
        @println("New expression features verified!")
    } else {
        @println("Verification failed.")
        @println(v.x)
        @println(v.y)
    }
    0
}
# Test: OOP polish - inheritance, interfaces, and super

interface Shape {
    fn area(): float
    fn name(): string
}

class BaseShape : Shape {
    fn area(): float -> 0.0
    fn name(): string -> "Generic Shape"
}

class Circle : BaseShape {
    radius: float

    fn init(r: float) {
        self.radius = r
    }

    override fn area(): float {
        return 3.14159 * self.radius * self.radius
    }

    override fn name(): string -> "Circle"
}

class Rectangle : BaseShape {
    w: float
    h: float

    fn init(w: float, h: float) {
        self.w = w
        self.h = h
    }

    override fn area(): float {
        return self.w * self.h
    }

    override fn name(): string -> "Rectangle"
}

# Test multi-level inheritance
class Square : Rectangle {
    fn init(s: float) {
        super.init(s, s)
    }

    override fn name(): string -> "Square"
}

fn print_shape(s: Shape) {
    @print("Shape: %s", s.name())
    @println(", Area: %f", s.area())
}

main() {
    c = Circle(5.0)
    r = Rectangle(4.0, 6.0)
    s = Square(3.0)

    print_shape(c)
    print_shape(r)
    print_shape(s)

    # Test virtual calls on base pointer
    b: BaseShape = c
    @println("Base pointer (Circle) name: %s", b.name())
    
    b = r
    @println("Base pointer (Rectangle) name: %s", b.name())

    0
}
class Base {
    fn name(): string -> "Base"
}

class Derived : Base {
    override fn name(): string -> "Derived"
}

main() {
    d = Derived()
    @println("Name: %s", d.name())
    
    b: Base = d
    @println("Base Name: %s", b.name())
    0
}


class Vector {
    pub x: int
    pub y: int

    pub fn init(self: Vector) {
        self.x = 0
        self.y = 0
    }

    pub fn +(self: Vector, other: Vector): Vector {
        res: Vector = Vector()
        res.x = self.x + other.x
        res.y = self.y + other.y
        return res
    }
}

fn main() {
    v1: Vector = Vector()
    v1.x = 10
    v1.y = 20

    v2: Vector = Vector()
    v2.x = 5
    v2.y = 15

    v3: Vector = v1 + v2
    
    # We can't print integers properly yet without formats, but we can verify it doesn't crash
    if v3.x == 15 {
        @println("Success\n")
    }
}


class Base {
    pub fn hello(self: Base) {
        @println("Base hello\n")
    }
}

class Derived : Base {
    override pub fn hello(self: Derived) {
        @println("Derived hello\n")
    }
}

fn main() {
    d: Derived = Derived()
    d.hello()
    0
}


