fn main() {
    mut x = 0;
    while x < 10 {
        for i in 0..5 {
            match i {
                0 => {
                    mut j = 0;
                    while j < 3 {
                        if j == 1 { break; }
                        j += 1;
                    }
                },
                _ => @println(i)
            }
        }
        x += 1;
    }
}
